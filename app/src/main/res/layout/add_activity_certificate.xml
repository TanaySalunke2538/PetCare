<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <!-- ============================= -->
    <!-- HEADER -->
    <!-- ============================= -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BACK BUTTON -->

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#F47C20"
            android:textSize="38sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>


        <!-- TITLE -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Certificate"
                android:textColor="#222222"
                android:textSize="25sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Save your pet's health document"
                android:textColor="#777777"
                android:textSize="13sp"/>

        </LinearLayout>

    </LinearLayout>


    <!-- ============================= -->
    <!-- SCROLL VIEW -->
    <!-- ============================= -->

    <ScrollView
        android:id="@+id/addCertificateScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="30dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="30dp">


            <!-- ============================= -->
            <!-- ORANGE GRADIENT UPLOAD CARD -->
            <!-- ============================= -->

            <LinearLayout
                android:id="@+id/uploadContainer"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/health_gradient"
                android:elevation="5dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvUploadIcon"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:gravity="center"
                    android:text="↑"
                    android:textColor="#F47C20"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:background="@drawable/iconcircle"/>

                <TextView
                    android:id="@+id/tvUploadTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Upload Certificate"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvUploadDescription"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Take a photo or select a certificate from your gallery"
                    android:textColor="#FFF5EA"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>


            <!-- ============================= -->
            <!-- IMAGE PREVIEW -->
            <!-- ============================= -->

            <ImageView
                android:id="@+id/imgCertificate"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp"
                android:scaleType="fitCenter"
                android:background="@drawable/button_light"
                android:padding="8dp"
                android:visibility="gone"
                android:contentDescription="Certificate preview"/>


            <!-- ============================= -->
            <!-- IMAGE BUTTONS -->
            <!-- ============================= -->

            <LinearLayout
                android:id="@+id/imageButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp">

                <Button
                    android:id="@+id/btnCamera"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Take Photo"
                    android:textAllCaps="false"
                    android:textColor="#F47C20"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_light"/>

                <Button
                    android:id="@+id/btnGallery"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Gallery"
                    android:textAllCaps="false"
                    android:textColor="#F47C20"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_light"/>

            </LinearLayout>


            <!-- ============================= -->
            <!-- CERTIFICATE INFORMATION CARD -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/button_light">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Certificate Details"
                    android:textColor="#222222"
                    android:textSize="18sp"
                    android:textStyle="bold"/>


                <!-- NAME -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Certificate Name"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etCertificateName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/button_light"
                    android:hint="e.g. Rabies Vaccination Certificate"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#222222"
                    android:textColorHint="#999999"
                    android:textSize="14sp"
                    android:singleLine="true"/>


                <!-- NOTE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:text="Note"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etNote"
                    android:layout_width="match_parent"
                    android:layout_height="105dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/button_light"
                    android:gravity="top|start"
                    android:hint="Add a short note about this certificate..."
                    android:padding="14dp"
                    android:textColor="#222222"
                    android:textColorHint="#999999"
                    android:textSize="14sp"
                    android:inputType="textMultiLine"
                    android:maxLines="5"/>

            </LinearLayout>


            <!-- ============================= -->
            <!-- SAVE BUTTON -->
            <!-- ============================= -->

            <Button
                android:id="@+id/btnSaveCertificate"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="22dp"
                android:text="Save Certificate"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/button_orange"
                android:elevation="5dp"/>


            <!-- ============================= -->
            <!-- INFORMATION -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/button_light">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="#F47C20"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Your certificate is temporarily stored on this device."
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>